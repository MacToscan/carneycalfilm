---
import '../styles.css';
import InstagramLink from '../components/InstagramLink.astro';
import { seo } from '../seo.mjs';
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown>;
}
const {
  title = seo.title,
  description = seo.description,
  noindex = false,
  structuredData,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(seo.image, Astro.site);
const verification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta
      name="theme-color"
      content="#151b17"
    />
    <meta
      name="generator"
      content={Astro.generator}
    />
    <title>{title}</title>
    <meta
      name="description"
      content={description}
    />
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow'}
    />
    {!noindex && (
      <link
        rel="canonical"
        href={canonical.href}
      />
    )}
    <meta
      property="og:type"
      content="website"
    />
    <meta
      property="og:locale"
      content="es_ES"
    />
    <meta
      property="og:site_name"
      content={`${seo.name} · Web oficial`}
    />
    <meta
      property="og:title"
      content={title}
    />
    <meta
      property="og:description"
      content={description}
    />
    <meta
      property="og:url"
      content={canonical.href}
    />
    <meta
      property="og:image"
      content={socialImage.href}
    />
    <meta
      property="og:image:type"
      content="image/jpeg"
    />
    <meta
      property="og:image:width"
      content="1200"
    />
    <meta
      property="og:image:height"
      content="630"
    />
    <meta
      property="og:image:alt"
      content={seo.imageAlt}
    />
    <meta
      name="twitter:card"
      content="summary_large_image"
    />
    <meta
      name="twitter:title"
      content={title}
    />
    <meta
      name="twitter:description"
      content={description}
    />
    <meta
      name="twitter:image"
      content={socialImage.href}
    />
    <meta
      name="twitter:image:alt"
      content={seo.imageAlt}
    />
    {verification && (
      <meta
        name="google-site-verification"
        content={verification}
      />
    )}
    {structuredData && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}
      />
    )}
  </head>

  <body>
    <a
      class="skip"
      href="#pelicula"
    >
      Saltar al contenido
    </a>

    <!-- Cabecera y navegación -->
    <header>
      <a
        class="producer-brand"
        href="https://maravillafilms.com/"
        aria-label="Maravilla Films, productora"
      >
        <img
          src="/images/logo_maravilla_large_opt.webp"
          alt="Maravilla Films"
          width="1600"
          height="461"
        />
      </a>

      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-navigation"
        aria-label="Abrir menú"
      >
        <span class="menu-label">Menú</span>
        <span
          class="menu-icon"
          aria-hidden="true"
        >
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>

      <nav
        id="site-navigation"
        aria-label="Navegación principal"
      >
        <a href="#pelicula">Historia</a>
        <a href="#imagenes">Imágenes</a>
        <a href="#reparto">Reparto</a>
        <a href="#equipo">Equipo</a>
        <a href="#prensa">Prensa</a>
        <a href="#teaser">Vídeos</a>
      </nav>
      <div class="header-instagram">
        <InstagramLink />
      </div>
    </header>

    <!-- Contenido de la página -->
    <main id="inicio">
      <slot />
    </main>

    <!-- Pie de página -->
    <footer>
      <p>
        Una producción de
        <br />
        <strong>Maravilla Films</strong>
      </p>
      <a
        class="text-link"
        href="#inicio"
      >
        Volver al inicio ↑
      </a>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const navigation = document.querySelector<HTMLElement>('#site-navigation');
      const mobile = window.matchMedia('(max-width: 1000px)');

      function setMenu(open: boolean, restoreFocus = false) {
        toggle?.setAttribute('aria-expanded', String(open));
        toggle?.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
        navigation?.classList.toggle('is-open', open);
        if (restoreFocus) toggle?.focus();
      }

      toggle?.addEventListener('click', () => {
        setMenu(toggle.getAttribute('aria-expanded') !== 'true');
      });

      navigation?.addEventListener('click', (event) => {
        if (mobile.matches && (event.target as Element).closest('a'))
          setMenu(false, true);
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
          setMenu(false, true);
        }
      });

      document.addEventListener('click', (event) => {
        const target = event.target as Node;
        if (!navigation?.contains(target) && !toggle?.contains(target)) setMenu(false);
      });

      document.addEventListener('focusin', (event) => {
        const target = event.target as Node;
        if (!navigation?.contains(target) && !toggle?.contains(target)) setMenu(false);
      });

      mobile.addEventListener('change', () => setMenu(false));
    </script>
  </body>
</html>

<style>
  .header-instagram {
    position: absolute;
    right: var(--gutter);
    display: flex;
    align-items: center;
  }

  @media (max-width: 1000px) {
    header .menu-toggle {
      margin-right: 52px;
    }

    .header-instagram {
      right: 16px;
    }
  }
</style>
