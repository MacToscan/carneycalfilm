---
import InstagramLink from './InstagramLink.astro';
import { editorial } from '../content.mjs';
---

<section
  class="hero"
  aria-labelledby="hero-heading"
>
  <div class="hero-copy">
    <p class="eyebrow hero-director">
      Una película de terror de <span class="director-name">Eduardo Álvarez</span>
    </p>

    <h1
      id="hero-heading"
      class="hook"
      aria-label="Bélmez, la historia de Carne y Cal. Las paredes nunca están vacías."
    >
      Las paredes <br />
      nunca están <br />
      <em>vacías.</em>
    </h1>

    <p class="hero-pitch">{editorial.pitch}</p>

    <div class="hero-actions">
      <a
        class="text-link"
        href="#teaser"
      >
        Explorar vídeos <span aria-hidden="true">▷</span>
      </a>
    </div>

    <div class="hero-social">
      <p class="presented-by">Maravilla Films presenta</p>
      <InstagramLink showHandle />
    </div>
  </div>

  <!-- El cartel mantiene el título y toda su identidad original. -->
  <figure id="cartel">
    <button
      class="poster-link"
      type="button"
      data-poster-open
      aria-label="Ampliar cartel oficial de Bélmez"
      aria-haspopup="dialog"
    >
      <img
        src="/images/belmez-poster-960.webp"
        srcset="/images/belmez-poster-480.webp 480w, /images/belmez-poster-960.webp 960w, /images/belmez-poster-1440.webp 1440w"
        sizes="(max-width: 1000px) 90vw, 45vw"
        alt="Bélmez: La historia de Carne y cal. Cartel oficial con una pared envejecida, retratos antiguos y luz cálida."
        width="1200"
        height="1800"
        fetchpriority="high"
      />
      <span
        class="poster-hover"
        aria-hidden="true"
      >
        Ver cartel completo <span>↗</span>
      </span>
    </button>
    <figcaption>
      <span>Cartel oficial</span>
      <span>Ampliar ↗</span>
    </figcaption>
  </figure>

  <div class="hero-note">
    <span>Bélmez · La historia de Carne y cal</span>
    <a href="#novedades">
      Sigue la película <span aria-hidden="true">↓</span>
    </a>
  </div>
</section>

<dialog
  class="poster-dialog"
  aria-label="Cartel oficial de Bélmez"
>
  <button
    type="button"
    class="dialog-close"
    aria-label="Cerrar cartel"
  >
    Cerrar ×
  </button>
  <img
    src="/images/belmez-poster.jpg"
    alt="Cartel oficial completo de Bélmez: La historia de Carne y cal"
    loading="lazy"
    decoding="async"
    width="1200"
    height="1800"
  />
</dialog>

<script>
  const posterDialog = document.querySelector<HTMLDialogElement>('.poster-dialog');
  const posterTrigger = document.querySelector<HTMLButtonElement>('[data-poster-open]');

  posterTrigger?.addEventListener('click', () => posterDialog?.showModal());
  posterDialog
    ?.querySelector('button')
    ?.addEventListener('click', () => posterDialog.close());
  posterDialog?.addEventListener('click', (event) => {
    if (event.target === posterDialog) posterDialog.close();
  });
  posterDialog?.addEventListener('close', () => posterTrigger?.focus());
</script>

<style>
  .hero-social {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  @media (max-width: 700px) {
    .hero-social {
      order: 5;
      align-items: center;
    }
  }
</style>
