---
import { film } from '../content.mjs';
const youtubeId = film.media.teaser;
---

<section
  class="section teaser"
  id="teaser"
  aria-labelledby="teaser-heading"
>
  <div class="section-label">
    <span>02 / Teaser oficial</span>
  </div>
  <div class="section-heading-row">
    <div>
      <p class="eyebrow">Una primera mirada al otro lado</p>
      <h2 id="teaser-heading">
        El silencio
        <br />
        <em>está a punto de romperse.</em>
      </h2>
    </div>
    {youtubeId && (
      <a
        class="text-link"
        href={`https://www.youtube.com/watch?v=${youtubeId}`}
        target="_blank"
        rel="noopener noreferrer"
      >
        Ver en YouTube ↗
      </a>
    )}
  </div>

  <div class="video-frame">
    {youtubeId ? (
      <iframe
        src={`https://www.youtube-nocookie.com/embed/${youtubeId}`}
        title="Teaser oficial de Bélmez"
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
      />
    ) : (
      <div class="video-pending">
        <span
          class="frame-mark"
          aria-hidden="true"
        >
          B / C
        </span>
        <p>Teaser oficial</p>
        <span>Próximamente</span>
      </div>
    )}
  </div>
</section>
