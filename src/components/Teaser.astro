---
import { videos } from '../videos.mjs';
const featured = videos[0];
---

<section
  class="section teaser video-library"
  id="teaser"
  aria-labelledby="teaser-heading"
>
  <div class="section-label">
    <span>02 / Vídeos</span>
  </div>
  <div class="section-heading-row">
    <div>
      <p class="eyebrow">Del guion a la pantalla</p>
      <h2 id="teaser-heading">
        Dentro de <em>Carne y Cal</em>
      </h2>
    </div>
    <p class="section-intro">Lecturas, rodaje y primeras miradas a la película.</p>
  </div>
  {featured ? (
    <>
      <div class="featured-video">
        <div
          class="video-frame"
          data-video-player
        >
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${featured.youtubeId}`}
            title={featured.title}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          />
        </div>
        <div
          class="video-description"
          aria-live="polite"
        >
          <p
            class="eyebrow"
            data-video-category
          >
            {featured.category}
          </p>
          <h3 data-video-title>{featured.title}</h3>
          <p
            class="section-intro"
            data-video-description
          >
            {featured.description}
          </p>
          <a
            class="text-link"
            data-video-link
            href={`https://www.youtube.com/watch?v=${featured.youtubeId}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            Ver en YouTube ↗
          </a>
        </div>
      </div>
      {videos.length > 1 && (
        <div
          class="video-selection"
          aria-label="Seleccionar vídeo"
        >
          {videos.map((video, index) => (
            <a
              class="video-card"
              href={`https://www.youtube.com/watch?v=${video.youtubeId}`}
              target="_blank"
              rel="noopener noreferrer"
              data-video-id={video.youtubeId}
              data-title={video.title}
              data-category={video.category}
              data-description={video.description}
              aria-current={index === 0 ? 'true' : undefined}
            >
              <img
                src={`https://i.ytimg.com/vi/${video.youtubeId}/hqdefault.jpg`}
                alt={`Portada de ${video.title}`}
                width="480"
                height="360"
                loading="lazy"
              />
              <span class="video-category">{video.category}</span>
              <span class="video-title">{video.title}</span>
            </a>
          ))}
        </div>
      )}
    </>
  ) : (
    <div class="video-empty">
      <span
        class="empty-play"
        aria-hidden="true"
      >
        ▷
      </span>
      <p class="eyebrow">Próximamente</p>
      <h3>La película también se vive detrás de la cámara.</h3>
      <p class="section-intro">
        Aquí encontrarás las lecturas de guion, el making of y los avances oficiales de
        Bélmez.
      </p>
    </div>
  )}
</section>

<script>
  document.querySelectorAll<HTMLElement>('.video-library').forEach((library) => {
    library.querySelectorAll<HTMLAnchorElement>('[data-video-id]').forEach((card) => {
      card.addEventListener('click', (event) => {
        if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
        const frame = library.querySelector<HTMLIFrameElement>('iframe');
        if (!frame) return;
        event.preventDefault();
        frame.src = `https://www.youtube-nocookie.com/embed/${card.dataset.videoId}`;
        frame.title = card.dataset.title || 'Vídeo de Bélmez';
        for (const key of ['title', 'category', 'description']) {
          const element = library.querySelector(`[data-video-${key}]`);
          if (element) element.textContent = card.dataset[key] || '';
        }
        const link = library.querySelector<HTMLAnchorElement>('[data-video-link]');
        if (link) link.href = card.href;
        library
          .querySelectorAll('[data-video-id]')
          .forEach((item) => item.removeAttribute('aria-current'));
        card.setAttribute('aria-current', 'true');
      });
    });
  });
</script>

<style>
  .video-library {
    min-height: auto;
  }
  .featured-video {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 36px;
    align-items: center;
  }
  .video-description h3,
  .video-empty h3 {
    font:
      normal clamp(24px, 3vw, 40px)/1.2 Georgia,
      serif;
    color: var(--ink);
    margin: 16px 0;
  }
  .video-empty {
    border: 1px solid var(--line);
    padding: clamp(32px, 6vw, 80px) 24px;
    text-align: center;
    background: #080d0960;
  }
  .video-empty .eyebrow {
    justify-content: center;
  }
  .video-empty h3,
  .video-empty .section-intro {
    max-width: 620px;
    margin-left: auto;
    margin-right: auto;
  }
  .empty-play {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border: 1px solid var(--gold);
    border-radius: 50%;
    color: var(--gold);
    font-size: 30px;
    margin-bottom: 24px;
  }
  .video-selection {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-top: 36px;
  }
  .video-card {
    min-width: 0;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
  }
  .video-card[aria-current='true'] {
    border-color: var(--gold);
  }
  .video-card img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: contain;
    background: #080d09;
  }
  .video-category {
    display: block;
    color: var(--gold);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin: 16px 0 8px;
  }
  .video-title {
    font:
      22px/1.3 Georgia,
      serif;
  }
  @media (max-width: 700px) {
    .featured-video {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .video-selection {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
    .video-title {
      font-size: 18px;
    }
  }
</style>
