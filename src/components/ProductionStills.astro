---
import { film } from '../content.mjs';
const photos = film.media.stills;
const first = photos[0];
---

<section
  class="section stills photo-gallery"
  id="imagenes"
  aria-labelledby="stills-heading"
  data-gallery
>
  <div class="section-label">
    <span>03 / Imágenes de producción</span>
    <span>Cuaderno de rodaje</span>
  </div>
  <div class="section-heading-row">
    <div>
      <p class="eyebrow">Dentro de la casa</p>
      <h2 id="stills-heading">
        Lo que guarda
        <br />
        <em>cada rincón.</em>
      </h2>
    </div>
    <p class="section-intro">
      Una mirada al universo de Bélmez.
      <br />
      Instantes al otro lado de la cámara.
    </p>
  </div>
  <div
    class="photo-stage"
    tabindex="0"
    role="group"
    aria-label="Fotografías del rodaje. Usa las flechas para navegar."
  >
    <a
      class="photo-main"
      href={first.full}
      data-enlarge
      aria-label="Ampliar fotografía"
    >
      <img
        data-main
        src={first.src}
        srcset={`${first.src} ${first.width}w, ${first.full} ${first.fullWidth}w`}
        sizes="(max-width: 700px) 92vw, 80vw"
        alt={first.alt}
        width={first.width}
        height={first.height}
        loading="lazy"
        decoding="async"
      />
      <span
        class="photo-expand"
        aria-hidden="true"
      >
        Ampliar ↗
      </span>
    </a>
    <span
      class="tv-static"
      aria-hidden="true"
    ></span>
    <button
      class="photo-arrow photo-prev"
      type="button"
      data-prev
      aria-label="Fotografía anterior"
    >
      ←
    </button>
    <button
      class="photo-arrow photo-next"
      type="button"
      data-next
      aria-label="Fotografía siguiente"
    >
      →
    </button>
  </div>
  <div class="photo-meta">
    <p
      data-count
      aria-live="polite"
      aria-atomic="true"
    >
      01 / {String(photos.length).padStart(2, '0')}
    </p>
    <p data-caption>{first.caption}</p>
    <span>Desliza o usa las flechas</span>
  </div>
  <div
    class="photo-thumbs"
    aria-label="Elegir fotografía"
  >
    {photos.map((photo, i) => (
      <a
        href={photo.full}
        data-pick={i}
        aria-label={`Ver fotografía ${i + 1}: ${photo.alt}`}
        aria-current={i === 0 ? 'true' : undefined}
      >
        <img
          src={photo.thumb}
          alt=""
          width={photo.width}
          height={photo.height}
          loading="lazy"
        />
      </a>
    ))}
  </div>
  <details class="photo-all">
    <summary>Ver todas las fotos ({photos.length})</summary>
    <div class="photo-grid">
      {photos.map((photo, i) => (
        <a
          href={photo.full}
          data-pick={i}
          aria-label={`Ver fotografía ${i + 1}: ${photo.alt}`}
        >
          <img
            src={photo.src}
            alt={photo.alt}
            width={photo.width}
            height={photo.height}
            loading="lazy"
            decoding="async"
          />
          <span>{String(i + 1).padStart(2, '0')}</span>
        </a>
      ))}
    </div>
  </details>
  <dialog
    class="photo-dialog"
    aria-label="Fotografía ampliada del rodaje"
  >
    <div class="photo-dialog-bar">
      <p
        data-modal-count
        aria-live="polite"
      ></p>
      <button
        type="button"
        data-close
      >
        Cerrar ×
      </button>
    </div>
    <div class="photo-modal-stage">
      <span
        class="tv-static"
        aria-hidden="true"
      ></span>
      <img
        data-modal-image
        width="1920"
        height="1280"
        alt=""
      />
      <button
        class="photo-arrow photo-prev"
        type="button"
        data-prev
        aria-label="Fotografía anterior"
      >
        ←
      </button>
      <button
        class="photo-arrow photo-next"
        type="button"
        data-next
        aria-label="Fotografía siguiente"
      >
        →
      </button>
    </div>
    <p data-modal-caption></p>
  </dialog>
  <script
    type="application/json"
    data-photos
    set:html={JSON.stringify(photos).replace(/</g, '\\u003c')}
  />
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const photos = JSON.parse(root.querySelector('[data-photos]')!.textContent!) as {
      src: string;
      full: string;
      alt: string;
      caption: string;
      fullWidth: number;
      width: number;
      height: number;
    }[];
    const main = root.querySelector<HTMLImageElement>('[data-main]')!;
    const enlarge = root.querySelector<HTMLAnchorElement>('[data-enlarge]')!;
    const dialog = root.querySelector<HTMLDialogElement>('dialog')!;
    const modal = root.querySelector<HTMLImageElement>('[data-modal-image]')!;
    const stage = root.querySelector<HTMLElement>('.photo-stage')!;
    let index = 0;
    let request = 0;
    let returnFocus: HTMLElement | null = null;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    async function select(next: number, animate = false) {
      const id = ++request;
      const target = (next + photos.length) % photos.length;
      const photo = photos[target];
      const preload = new Image();
      preload.src = photo.src;
      try {
        await preload.decode();
      } catch {
        return;
      }
      if (id !== request) return;
      index = target;
      if (animate && !reduced.matches) {
        const screen = dialog.open
          ? root.querySelector<HTMLElement>('.photo-modal-stage')!
          : stage;
        const noise = screen.querySelector<HTMLElement>('.tv-static')!;
        const ratio = photo.width / photo.height;
        const width = Math.min(screen.clientWidth, screen.clientHeight * ratio);
        const height = width / ratio;
        Object.assign(noise.style, {
          width: `${width}px`,
          height: `${height}px`,
          left: `${(screen.clientWidth - width) / 2}px`,
          top: `${(screen.clientHeight - height) / 2}px`,
        });
        noise.getAnimations().forEach((animation) => animation.cancel());
        noise.animate(
          [
            { opacity: 0 },
            { opacity: 0.4, offset: 0.25 },
            { opacity: 0.3, offset: 0.55 },
            { opacity: 0 },
          ],
          { duration: 700 },
        );
        noise.querySelectorAll('span').forEach((band) => {
          band.getAnimations().forEach((animation) => animation.cancel());
          band.animate(
            [
              { transform: 'translateY(0)' },
              { transform: 'translateY(90px)', offset: 0.3 },
              { transform: 'translateY(-45px)', offset: 0.6 },
              { transform: 'translateY(0)' },
            ],
            { duration: 700 },
          );
        });
      }
      main.srcset = `${photo.src} ${photo.width}w, ${photo.full} ${photo.fullWidth}w`;
      main.src = photo.src;
      main.alt = photo.alt;
      main.width = photo.width;
      main.height = photo.height;
      enlarge.href = photo.full;
      const count = `${String(index + 1).padStart(2, '0')} / ${String(photos.length).padStart(2, '0')}`;
      root.querySelector('[data-count]')!.textContent = count;
      root.querySelector('[data-caption]')!.textContent = photo.caption;
      root
        .querySelectorAll<HTMLAnchorElement>('.photo-thumbs [data-pick]')
        .forEach((item) => {
          const active = Number(item.dataset.pick) === index;
          if (active) {
            item.setAttribute('aria-current', 'true');
            const strip = item.parentElement!;
            strip.scrollTo({
              left:
                item.offsetLeft -
                strip.offsetLeft -
                (strip.clientWidth - item.clientWidth) / 2,
              behavior: reduced.matches ? 'instant' : 'smooth',
            });
          } else item.removeAttribute('aria-current');
        });
      if (dialog.open) {
        modal.src = photo.full;
        modal.alt = photo.alt;
        root.querySelector('[data-modal-count]')!.textContent = count;
        root.querySelector('[data-modal-caption]')!.textContent = photo.caption;
      }
    }
    root.querySelectorAll<HTMLAnchorElement>('[data-pick]').forEach((item) =>
      item.addEventListener('click', (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        void select(Number(item.dataset.pick), true);
        if (item.closest('.photo-grid')) {
          root.querySelector('details')!.open = false;
          stage.focus({ preventScroll: true });
          stage.scrollIntoView({
            block: 'center',
            behavior: reduced.matches ? 'instant' : 'smooth',
          });
        }
      }),
    );
    root
      .querySelectorAll('[data-prev]')
      .forEach((button) =>
        button.addEventListener('click', () => void select(index - 1, true)),
      );
    root
      .querySelectorAll('[data-next]')
      .forEach((button) =>
        button.addEventListener('click', () => void select(index + 1, true)),
      );
    enlarge.addEventListener('click', (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      returnFocus = document.activeElement as HTMLElement;
      dialog.showModal();
      document.documentElement.classList.add('photo-modal-open');
      void select(index);
    });
    dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('photo-modal-open');
      modal.removeAttribute('src');
      returnFocus?.focus({ preventScroll: true });
    });
    for (const area of [stage, dialog]) {
      area.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
          event.preventDefault();
          void select(index + (event.key === 'ArrowRight' ? 1 : -1), true);
        }
      });
      let x = 0,
        y = 0;
      area.addEventListener(
        'touchstart',
        (event) => {
          x = event.changedTouches[0].clientX;
          y = event.changedTouches[0].clientY;
        },
        { passive: true },
      );
      area.addEventListener(
        'touchend',
        (event) => {
          const dx = event.changedTouches[0].clientX - x,
            dy = event.changedTouches[0].clientY - y;
          if (Math.abs(dx) > 55 && Math.abs(dx) > Math.abs(dy) * 1.5)
            void select(index + (dx < 0 ? 1 : -1));
        },
        { passive: true },
      );
    }
  });
</script>

<style>
  .tv-static {
    position: absolute;
    z-index: 2;
    pointer-events: none;
    opacity: 0;
    overflow: hidden;
    background: repeating-linear-gradient(
      0deg,
      transparent 0 5px,
      #e7e4cf1c 5px 6px,
      transparent 6px 11px
    );
  }
  .tv-static > span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 7%;
    top: 18%;
    background: repeating-linear-gradient(
      0deg,
      #e3ddc44d 0 1px,
      #090c0980 1px 3px,
      transparent 3px 5px
    );
    box-shadow: 0 8px 20px #d6d1b520;
  }
  .tv-static > span:last-child {
    top: 68%;
    height: 3%;
  }
  @media (prefers-reduced-motion: reduce) {
    .tv-static {
      display: none;
    }
  }
  .section.photo-gallery {
    height: auto;
    min-height: 0;
    display: block;
  }
  .photo-stage {
    position: relative;
    width: 100%;
    height: clamp(260px, 55svh, 680px);
    background: #080d0970;
  }
  .photo-main {
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    position: relative;
  }
  .photo-main img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .photo-expand {
    position: absolute;
    bottom: 14px;
    right: 16px;
    background: #080d09d9;
    padding: 8px 12px;
    color: var(--ink);
    font-size: 11px;
  }
  .photo-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    border: 1px solid var(--gold);
    background: #080d09d9;
    color: var(--gold);
    width: 48px;
    height: 48px;
    font-size: 26px;
    cursor: pointer;
    z-index: 1;
  }
  .photo-prev {
    left: 12px;
  }
  .photo-next {
    right: 12px;
  }
  .photo-arrow:hover {
    background: #252c20;
  }
  .photo-meta {
    display: flex;
    align-items: center;
    gap: 24px;
    color: var(--muted);
    font-size: 11px;
    min-height: 48px;
  }
  .photo-meta [data-count] {
    color: var(--gold);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .photo-meta > span {
    margin-left: auto;
  }
  .photo-thumbs {
    position: relative;
    display: flex;
    gap: 10px;
    overflow-x: auto;
    padding: 8px 2px 16px;
    scrollbar-color: var(--gold) #10150f;
  }
  .photo-thumbs a {
    display: block;
    flex: 0 0 100px;
    height: 72px;
    border: 1px solid transparent;
    padding: 3px;
  }
  .photo-thumbs a[aria-current] {
    border-color: var(--gold);
  }
  .photo-thumbs img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #080d09;
  }
  .photo-all {
    margin-top: 16px;
  }
  .photo-all summary {
    cursor: pointer;
    color: var(--gold);
    padding: 14px 0;
    font-size: 13px;
  }
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    padding-top: 16px;
  }
  .photo-grid img {
    width: 100%;
    height: 180px;
    object-fit: contain;
    background: #080d0980;
  }
  .photo-grid span {
    display: block;
    color: var(--gold);
    font-size: 11px;
    padding-top: 8px;
  }
  .photo-dialog {
    padding: 20px;
    width: 96vw;
    max-width: 1600px;
    max-height: 96svh;
    border: 1px solid var(--line);
    background: #080d09;
    color: var(--ink);
  }
  .photo-dialog::backdrop {
    background: #000e;
  }
  .photo-dialog-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    font-size: 12px;
  }
  .photo-dialog-bar button {
    min-height: 44px;
    padding: 8px 16px;
    border: 1px solid var(--line);
    color: var(--ink);
    background: none;
    cursor: pointer;
  }
  .photo-modal-stage {
    height: calc(90svh - 130px);
    position: relative;
  }
  .photo-modal-stage img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  [data-modal-caption] {
    font-size: 12px;
    color: var(--muted);
  }
  :global(html.photo-modal-open) {
    overflow: hidden;
  }
  @media (max-width: 700px) {
    .photo-gallery .section-heading-row {
      flex-direction: column;
      align-items: flex-start;
    }
    .photo-stage {
      height: clamp(240px, 48svh, 480px);
    }
    .photo-arrow {
      width: 44px;
      height: 44px;
    }
    .photo-prev {
      left: 4px;
    }
    .photo-next {
      right: 4px;
    }
    .photo-meta {
      gap: 12px;
    }
    .photo-meta > span {
      display: none;
    }
    .photo-thumbs a {
      flex-basis: 76px;
      height: 58px;
    }
    .photo-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
    .photo-grid img {
      height: 140px;
    }
    .photo-dialog {
      padding: 12px;
    }
  }
</style>
