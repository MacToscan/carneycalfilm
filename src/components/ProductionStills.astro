---
import { film } from '../content.mjs';
const photos = film.media.stills;
const compositions = [photos.slice(0, 5), photos.slice(5)];
---

<section
  class="section stills"
  id="imagenes"
  aria-labelledby="stills-heading"
  data-still-gallery
>
  <div class="section-label">
    <span>03 / Imágenes de producción</span>
    <span>Cuaderno de rodaje</span>
  </div>
  <div class="section-heading-row">
    <div>
      <p class="eyebrow">Dentro de la casa</p>
      <h2 id="stills-heading">
        Lo que guarda
        <br />
        <em>cada rincón.</em>
      </h2>
    </div>
    <p class="section-intro">
      Una mirada al universo de Bélmez.
      <br />
      Instantes al otro lado de la cámara.
    </p>
  </div>
  <div
    class="collage-stage"
    id="stills-compositions"
  >
    {compositions.map((group, groupIndex) => (
      <div
        class:list={['collage', `collage-${groupIndex + 1}`]}
        data-composition
        aria-label={`Composición ${groupIndex + 1} de 2`}
      >
        {group.map((photo, slot) => (
          <a
            class:list={['collage-photo', `slot-${slot + 1}`]}
            href={photo.full}
            data-still
            data-index={photos.indexOf(photo)}
            aria-label={`Ampliar: ${photo.alt}`}
          >
            <img
              src={photo.src}
              alt={photo.alt}
              width={photo.width}
              height={photo.height}
              loading="lazy"
              decoding="async"
            />
            <span class="photo-edge">
              <span>{String(photos.indexOf(photo) + 1).padStart(2, '0')}</span>
              <span aria-hidden="true">↗</span>
            </span>
          </a>
        ))}
      </div>
    ))}
    <div
      class="tape-interference"
      aria-hidden="true"
    >
      <span></span>
    </div>
  </div>
  <div
    class="collage-controls"
    hidden
  >
    <p>
      Instantes del rodaje{' '}
      <span
        class="collage-count"
        aria-live="polite"
        aria-atomic="true"
      >
        01 / 02
      </span>
    </p>
    <div>
      <button
        type="button"
        data-collage-prev
        aria-label="Composición anterior"
        aria-controls="stills-compositions"
      >
        ←
      </button>
      <button
        type="button"
        data-collage-next
        aria-label="Composición siguiente"
        aria-controls="stills-compositions"
      >
        →
      </button>
    </div>
  </div>
  <dialog
    class="stills-dialog"
    aria-label="Fotografías del rodaje de Bélmez"
  >
    <div class="viewer-toolbar">
      <p
        data-viewer-count
        aria-live="polite"
        aria-atomic="true"
      ></p>
      <button
        type="button"
        data-viewer-close
        aria-label="Cerrar fotografía"
      >
        Cerrar ×
      </button>
    </div>
    <div class="viewer-image">
      <img
        data-viewer-image
        alt=""
        width="2400"
        height="1600"
      />
      <p
        data-viewer-error
        hidden
      >
        No se ha podido cargar la fotografía. <a data-viewer-original>Ver imagen</a>
      </p>
    </div>
    <div class="viewer-footer">
      <button
        type="button"
        data-photo-prev
        aria-label="Fotografía anterior"
      >
        ←
      </button>
      <p data-viewer-caption></p>
      <button
        type="button"
        data-photo-next
        aria-label="Fotografía siguiente"
      >
        →
      </button>
    </div>
  </dialog>
</section>

<script>
  const gallery = document.querySelector<HTMLElement>('[data-still-gallery]');
  if (gallery) {
    const panels = [...gallery.querySelectorAll<HTMLElement>('[data-composition]')];
    const links = [...gallery.querySelectorAll<HTMLAnchorElement>('[data-still]')];
    const stage = gallery.querySelector<HTMLElement>('.collage-stage')!;
    const controls = gallery.querySelector<HTMLElement>('.collage-controls')!;
    const count = gallery.querySelector<HTMLElement>('.collage-count')!;
    const dialog = gallery.querySelector<HTMLDialogElement>('dialog')!;
    const image = gallery.querySelector<HTMLImageElement>('[data-viewer-image]')!;
    const error = gallery.querySelector<HTMLElement>('[data-viewer-error]')!;
    const original = gallery.querySelector<HTMLAnchorElement>('[data-viewer-original]')!;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let currentPanel = 0;
    let currentPhoto = 0;
    let busy = false;
    let trigger: HTMLAnchorElement | undefined;
    let previousOverflow = '';
    gallery.classList.add('gallery-ready');
    panels.forEach((panel, index) => {
      panel.hidden = index !== 0;
    });
    controls.hidden = false;

    async function changeComposition(direction: number) {
      if (busy || dialog.open) return;
      busy = true;
      controls.querySelectorAll('button').forEach((button) => {
        button.setAttribute('aria-disabled', 'true');
      });
      const next = (currentPanel + direction + panels.length) % panels.length;
      const outgoing = panels[currentPanel];
      const incoming = panels[next];
      const distance = direction * 64;
      stage.classList.toggle('tape-reverse', direction < 0);
      if (!reducedMotion.matches) stage.classList.add('tape-changing');
      try {
        if (!reducedMotion.matches) {
          await outgoing.animate(
            [
              { opacity: 1, transform: 'translateX(0)' },
              { opacity: 0, transform: `translateX(${-distance}px)` },
            ],
            { duration: 480, easing: 'ease-in', fill: 'forwards' },
          ).finished;
        }
        outgoing.hidden = true;
        outgoing.getAnimations().forEach((animation) => animation.cancel());
        incoming.hidden = false;
        currentPanel = next;
        count.textContent = `0${next + 1} / 02`;
        if (!reducedMotion.matches) {
          await incoming.animate(
            [
              { opacity: 0, transform: `translateX(${distance}px)` },
              { opacity: 1, transform: 'translateX(0)' },
            ],
            { duration: 620, easing: 'ease-out' },
          ).finished;
        }
      } finally {
        stage.classList.remove('tape-changing');
        busy = false;
        controls.querySelectorAll('button').forEach((button) => {
          button.removeAttribute('aria-disabled');
        });
      }
    }
    gallery
      .querySelector('[data-collage-prev]')
      ?.addEventListener('click', () => void changeComposition(-1));
    gallery
      .querySelector('[data-collage-next]')
      ?.addEventListener('click', () => void changeComposition(1));

    function showPhoto(index: number) {
      currentPhoto = (index + links.length) % links.length;
      const link = links[currentPhoto];
      const thumbnail = link.querySelector('img')!;
      image.alt = thumbnail.alt;
      image.width = thumbnail.width;
      image.height = thumbnail.height;
      image.src = link.href;
      error.hidden = true;
      original.href = link.href;
      gallery.querySelector('[data-viewer-count]')!.textContent =
        `${String(currentPhoto + 1).padStart(2, '0')} / ${String(links.length).padStart(2, '0')}`;
      gallery.querySelector('[data-viewer-caption]')!.textContent = thumbnail.alt;
    }
    image.addEventListener('error', () => {
      error.hidden = false;
    });
    image.addEventListener('load', () => {
      error.hidden = true;
    });
    links.forEach((link, index) =>
      link.addEventListener('click', (event) => {
        if (
          event.ctrlKey ||
          event.metaKey ||
          event.shiftKey ||
          event.altKey ||
          busy ||
          typeof dialog.showModal !== 'function'
        )
          return;
        event.preventDefault();
        trigger = link;
        showPhoto(index);
        previousOverflow = document.body.style.overflow;
        document.body.style.overflow = 'hidden';
        dialog.showModal();
      }),
    );
    gallery
      .querySelector('[data-viewer-close]')
      ?.addEventListener('click', () => dialog.close());
    gallery
      .querySelector('[data-photo-prev]')
      ?.addEventListener('click', () => showPhoto(currentPhoto - 1));
    gallery
      .querySelector('[data-photo-next]')
      ?.addEventListener('click', () => showPhoto(currentPhoto + 1));
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
        event.preventDefault();
        showPhoto(currentPhoto + (event.key === 'ArrowLeft' ? -1 : 1));
      }
    });
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => {
      document.body.style.overflow = previousOverflow;
      trigger?.focus({ preventScroll: true });
      image.removeAttribute('src');
    });
  }
</script>

<style>
  .collage-stage {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 24px 10px 12px;
  }
  .gallery-ready .collage-stage {
    height: calc(clamp(580px, 49vw, 740px) + 36px);
    overflow-anchor: none;
  }
  .collage {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(16px, 2.5vw, 38px);
    align-items: start;
    margin-bottom: 56px;
  }
  .gallery-ready .collage[hidden],
  .collage[hidden],
  .collage-controls[hidden],
  [data-viewer-error][hidden] {
    display: none;
  }
  .gallery-ready .collage {
    margin-bottom: 0;
  }
  .collage-photo {
    display: block;
    position: relative;
    color: var(--gold);
    text-decoration: none;
    min-width: 0;
    transition: transform 0.25s ease;
  }
  .collage-photo img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid #c6ae7c4d;
    box-shadow: 0 12px 30px #0005;
  }
  .collage-photo:hover {
    transform: translateY(-5px);
  }
  .collage-photo:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 6px;
  }
  .photo-edge {
    display: flex;
    justify-content: space-between;
    padding-top: 9px;
    font-size: 10px;
    letter-spacing: 0.15em;
    opacity: 0.7;
  }
  .collage-1 .slot-1 {
    grid-column: 1 / 4;
    grid-row: 1 / 3;
    margin-top: 56px;
  }
  .collage-1 .slot-2 {
    grid-column: 4 / 9;
    grid-row: 1;
  }
  .collage-1 .slot-3 {
    grid-column: 10 / 13;
    grid-row: 1 / 3;
    margin-top: 100px;
  }
  .collage-1 .slot-4 {
    grid-column: 4 / 7;
    grid-row: 2;
    margin-top: 4px;
  }
  .collage-1 .slot-5 {
    grid-column: 7 / 10;
    grid-row: 2;
    margin-top: 38px;
  }
  .collage-2 .slot-1 {
    grid-column: 1 / 4;
    grid-row: 1 / 3;
    margin-top: 50px;
  }
  .collage-2 .slot-2 {
    grid-column: 4 / 9;
    grid-row: 1;
    margin-top: 12px;
  }
  .collage-2 .slot-3 {
    grid-column: 10 / 13;
    grid-row: 1 / 3;
    margin-top: 90px;
  }
  .collage-2 .slot-4 {
    grid-column: 5 / 9;
    grid-row: 2;
    margin-top: 14px;
  }
  .gallery-ready .collage {
    height: clamp(580px, 49vw, 740px);
    grid-template-rows: 1.3fr 1fr;
  }
  .collage-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    border-top: 1px solid #c6ae7c33;
    padding-top: 24px;
    margin-top: 22px;
  }
  .collage-controls p {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .collage-count {
    margin-left: 24px;
    color: var(--gold);
    white-space: nowrap;
  }
  .collage-controls > div {
    display: flex;
    gap: 10px;
  }
  .collage-controls button,
  .viewer-footer button {
    width: 52px;
    height: 48px;
    border: 1px solid #c6ae7c77;
    background: transparent;
    color: var(--gold);
    cursor: pointer;
    font-size: 25px;
  }
  button:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 4px;
  }
  .collage-controls button:hover,
  .viewer-footer button:hover {
    background: #c6ae7c16;
  }
  .collage-controls button[aria-disabled='true'] {
    opacity: 0.45;
    cursor: wait;
  }
  .tape-interference {
    display: none;
    pointer-events: none;
    position: absolute;
    inset: 0;
    z-index: 5;
    opacity: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent 0 5px,
      #e7e4cf1c 5px 6px,
      transparent 6px 11px
    );
  }
  .tape-changing .tape-interference {
    display: block;
    animation: tape-signal 1100ms linear both;
  }
  .tape-interference::before,
  .tape-interference::after {
    content: '';
    position: absolute;
    left: -5%;
    width: 110%;
    height: 7%;
    background: repeating-linear-gradient(
      0deg,
      #e3ddc44d 0 1px,
      #090c0980 1px 3px,
      transparent 3px 5px
    );
    box-shadow: 0 8px 20px #d6d1b520;
  }
  .tape-interference::before {
    top: 18%;
    transform: skewX(-14deg);
  }
  .tape-interference::after {
    top: 68%;
    height: 3%;
    transform: skewX(10deg);
  }
  .tape-reverse .tape-interference {
    animation-direction: reverse;
  }
  @keyframes tape-signal {
    0%,
    100% {
      opacity: 0;
      transform: translateY(0);
    }
    20% {
      opacity: 0.55;
      transform: translate(2px, 8%);
    }
    45% {
      opacity: 0.7;
      transform: translate(-3px, -12%);
    }
    65% {
      opacity: 0.5;
      transform: translate(3px, 17%);
    }
    85% {
      opacity: 0.25;
      transform: translateY(-6%);
    }
  }
  .stills-dialog {
    position: fixed;
    inset: 0;
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 24px clamp(16px, 4vw, 64px);
    border: 0;
    background: #070b08f7;
    color: #e5e3d6;
  }
  .stills-dialog[open] {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .stills-dialog::backdrop {
    background: #030503ed;
  }
  .viewer-toolbar,
  .viewer-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-shrink: 0;
  }
  .viewer-toolbar p {
    margin: 0;
    color: var(--gold);
    letter-spacing: 0.2em;
    font-size: 12px;
  }
  .viewer-toolbar button {
    padding: 12px 18px;
    background: transparent;
    border: 1px solid #c6ae7c77;
    color: inherit;
    cursor: pointer;
  }
  .viewer-image {
    flex: 1;
    min-height: 0;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .viewer-image img {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: contain;
  }
  .viewer-footer p {
    margin: 0;
    font-size: 12px;
    line-height: 1.5;
    text-align: center;
    max-width: 700px;
  }
  .viewer-footer button {
    flex-shrink: 0;
  }
  [data-viewer-error] {
    position: absolute;
    padding: 20px;
    background: #10150f;
  }
  [data-viewer-error] a {
    color: var(--gold);
  }
  @media (max-width: 700px) {
    .gallery-ready .collage-stage {
      height: calc(190vw + 20px);
    }
    .collage-stage {
      padding: 8px 3px 12px;
    }
    .collage {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px 16px;
    }
    .collage .collage-photo {
      grid-column: auto;
      grid-row: auto;
      margin-top: 0;
    }
    .collage .slot-2 {
      margin-top: 52px;
    }
    .collage .slot-4 {
      margin-top: 35px;
    }
    .collage-1 .slot-5 {
      grid-column: 1 / 3;
      width: 75%;
      justify-self: center;
    }
    .gallery-ready .collage {
      height: auto;
      min-height: 175vw;
      grid-template-rows: auto;
    }
    .collage-controls {
      margin-top: 12px;
      padding-top: 18px;
    }
    .collage-controls p {
      font-size: 9px;
      max-width: 160px;
      line-height: 1.8;
    }
    .collage-count {
      display: block;
      margin: 0;
    }
    .stills-dialog {
      padding: 12px;
    }
    .viewer-footer p {
      font-size: 10px;
    }
    .viewer-footer button {
      width: 42px;
      height: 44px;
    }
  }
  @media (min-width: 701px) and (min-height: 480px) {
    .gallery-ready .collage-stage {
      flex: 1;
      min-height: 0;
      height: auto;
      padding: 0;
      container-type: size;
    }
    .gallery-ready .collage {
      position: absolute;
      left: 50%;
      top: 50%;
      translate: -50% -50%;
      width: min(100cqw, 200cqh);
      height: min(100cqh, 50cqw);
      min-height: 0;
      display: block;
    }
    .collage .collage-photo {
      position: absolute;
      margin: 0;
      width: 23%;
      height: 80%;
      top: 8%;
      left: 0;
    }
    .collage-photo img {
      width: 100%;
      height: calc(100% - 20px);
      object-fit: contain;
      border: 0;
      box-shadow: none;
    }
    .collage-1 .slot-2,
    .collage-2 .slot-2 {
      width: 40%;
      height: 55%;
      left: 26%;
      top: 0;
    }
    .collage-1 .slot-3,
    .collage-2 .slot-3 {
      width: 23%;
      height: 80%;
      left: 77%;
      top: 16%;
    }
    .collage-1 .slot-4 {
      width: 24%;
      height: 36%;
      left: 26%;
      top: 60%;
    }
    .collage-1 .slot-5 {
      width: 24%;
      height: 36%;
      left: 52%;
      top: 64%;
    }
    .collage-2 .slot-4 {
      width: 34%;
      height: 40%;
      left: 32%;
      top: 60%;
    }
    .photo-edge {
      padding-top: 4px;
      font-size: 9px;
    }
    .collage-controls {
      margin-top: 8px;
      padding-top: 8px;
      flex-shrink: 0;
    }
    .collage-controls p {
      margin-block: 8px;
    }
    .collage-controls button {
      width: 46px;
      height: 40px;
    }
  }
  @media (max-width: 700px) {
    .gallery-ready .collage-stage {
      height: auto;
    }
    .gallery-ready .collage {
      min-height: 0;
      gap: 14px 14px;
    }
    .collage .slot-2 {
      margin-top: 24px;
    }
    .collage .slot-4 {
      margin-top: 16px;
    }
    .collage-1 .slot-5 {
      width: 64%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .collage-photo {
      transition: none;
    }
    .collage-photo:hover {
      transform: none;
    }
    .tape-changing .tape-interference {
      display: none;
      animation: none;
    }
  }
</style>
